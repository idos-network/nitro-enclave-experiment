{
  "name": "@idos/tee-common",
  "version": "1.0.0",
  "description": "TypeScript shared by the TEE services. Source only: services run it via Node type stripping, so it must never be copied into node_modules",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./*"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@pyroscope/nodejs": "^0.7.1",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.5",
    "@types/swagger-ui-express": "^4.1.8"
  }
}
